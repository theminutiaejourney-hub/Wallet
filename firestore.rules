rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable, hardened global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper to extract incoming document properties safely
    function incoming() {
      return request.resource.data;
    }

    // Helper to extract existing document properties safely
    function existing() {
      return resource.data;
    }

    // Entity shapes validations
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256;
    }

    function isValidAccount(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.name is string && data.name.size() <= 256
        && data.type is string && data.type.size() <= 128
        && data.balance is number
        && data.color is string && data.color.size() <= 256;
    }

    function isValidTransaction(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.accountId is string && data.accountId.size() <= 128
        && data.type is string && (data.type == 'income' || data.type == 'expense' || data.type == 'transfer')
        && data.amount is number && data.amount >= 0
        && data.category is string && data.category.size() <= 256
        && data.date is string && data.date.size() <= 128;
    }

    function isValidDebt(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.person is string && data.person.size() <= 256
        && data.amount is number && data.amount >= 0
        && data.type is string && (data.type == 'receive' || data.type == 'pay')
        && data.date is string && data.date.size() <= 128
        && data.status is string && (data.status == 'pending' || data.status == 'settled');
    }

    function isValidScheduledExpense(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.accountId is string && data.accountId.size() <= 128
        && data.amount is number && data.amount >= 0
        && data.category is string && data.category.size() <= 256
        && data.description is string && data.description.size() <= 512
        && data.date is string && data.date.size() <= 128
        && data.status is string && (data.status == 'pending' || data.status == 'paid');
    }

    // Rules for individual collections nested under the owner's users document
    match /users/{userId} {
      allow get, write: if isOwner(userId) && isValidId(userId) && (request.method != 'create' || isValidUserProfile(incoming()));

      match /accounts/{accountId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(accountId) && isValidAccount(incoming());
        allow delete: if isOwner(userId) && isValidId(accountId);
      }

      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(incoming());
        allow delete: if isOwner(userId) && isValidId(transactionId);
      }

      match /debts/{debtId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(debtId) && isValidDebt(incoming());
        allow delete: if isOwner(userId) && isValidId(debtId);
      }

      match /scheduledExpenses/{scheduledExpenseId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(scheduledExpenseId) && isValidScheduledExpense(incoming());
        allow delete: if isOwner(userId) && isValidId(scheduledExpenseId);
      }
    }
  }
}
